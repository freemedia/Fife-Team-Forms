<script>
let globalLocation=null, locStatus='idle', locError='', watchId=null;
let uPhotos=[], tPhotos={}, TEAM=["David H","Dale C","Darren B","George B","Connor B","Morgan R","Nicu","Mirabela","Marian","Mihaela","Nicolae","Gemma H","Sharon P","Maxine S","Shannon S","Ryan B","Darren M (leader)","Lynne W (leader)","David A","Alan M"], REASONS=["Standard to Major","Partial to Major","Trauma Clean","Sharps Removal","Bodily Waste","Flea Treatment","Excess Waste/Hoarder","Gas Canister Removal","Tyre Removal","Other"], VEHICLES=["BL18 RZW - Tipper","LE25 MPX - Big Van","KX19 NTC - Tipper","CV21 UHP - Tipper","DS25 APK - Tipper","BG71 WSK - Tipper","LE25 MTO - Big Van","CV22 HCH - Tipper","YR25 DWZ - Luton","CV71 LYO - Tipper","CP21 BSZ - Tipper"], SITES=["Cireco Dunfermline","Ladybank","Enva Glenrothes","Enva Newbridge","Recycle Fife Lochgelly Tip","Other"];
function nowHM(){const d=new Date();return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');}
function todayISO(){return new Date().toISOString().slice(0,10);}
function toast(m){const t=document.getElementById('toast');t.textContent=m;t.classList.remove('hidden');setTimeout(()=>t.classList.add('hidden'),3000);}

function checkHTTPS(){
  const badge=document.getElementById('httpsBadge');
  const warn=document.getElementById('httpsWarning');
  const isSecure=window.isSecureContext;
  if(isSecure){ badge.textContent='HTTPS ✅ Secure'; badge.style.background='#dcfce7'; badge.style.color='#14532d';
  } else {
    badge.textContent='HTTP ❌ Not Secure'; badge.style.background='#fef2f2'; badge.style.color='#7f1d1d';
    warn.innerHTML=`<div class="banner banner-red"><b>⚠️ NOT HTTPS - GPS WILL NOT WORK</b><br>This page must be opened via https://<br>Current: ${location.protocol}//${location.host}<br><br>For Netlify/Cloudflare it is automatically HTTPS. For your own server, install free SSL via cPanel → Let's Encrypt.<br><button onclick="location.protocol='https:'" style="margin-top:8px;padding:8px 14px;border-radius:8px;background:#7f1d1d;color:#fff;border:0;font-weight:700;cursor:pointer">Switch to HTTPS Now</button></div>`;
  }
}

function updateGPSBanner(){
  const el=document.getElementById('gpsBanner');
  const secure=window.isSecureContext;
  let html='';
  if(!secure){ html=`<div class="banner banner-red">📍 GPS blocked - page is not HTTPS. Host on https:// for GPS to work.</div>`; }
  else if(locStatus==='idle'){ html=`<div class="banner banner-blue"><b>📍 TAP HERE TO ENABLE GPS TRACKING</b><br>Required for all reports - iPhone will ask for permission<br><button onclick="requestGPS()">ENABLE GPS NOW</button><div style="margin-top:8px;font-size:11px;opacity:.9">This tap is required by iOS Safari</div></div>`; }
  else if(locStatus==='locating'){ html=`<div class="banner banner-green" style="background:#fef9c3;color:#854d0e">📍 Locating... Getting GPS fix - move outside if needed, wait 5-10 seconds...</div>`; }
  else if(locStatus==='blocked'||locStatus==='denied'){ html=`<div class="banner banner-orange"><b>📍 Location Blocked</b><br>${locError}<br><div style="display:flex;gap:8px;margin-top:10px"><button onclick="requestGPS()" style="flex:1;padding:10px;border-radius:10px;background:#111827;color:#fff;font-weight:700;border:0">Try Again</button><button onclick="alert('iPhone: Settings → Privacy & Security → Location Services → ON → Safari Websites → Allow While Using. Then Safari aA → Website Settings → Location → Allow. Android: Tap 🔒 lock icon → Site settings → Location → Allow.')" style="flex:1;padding:10px;border-radius:10px;background:#fff;border:1px solid #9ca3af;font-weight:700">How to Enable</button></div></div>`; }
  else if(locStatus==='granted'&&globalLocation){ html=`<div class="banner banner-green">📍 GPS Active: ${globalLocation.lat.toFixed(6)}, ${globalLocation.lng.toFixed(6)} ±${globalLocation.accuracy}m at ${globalLocation.timestamp}<br><a href="https://maps.google.com?q=${globalLocation.lat},${globalLocation.lng}" target="_blank" style="font-weight:800;color:#14532d;text-decoration:underline">Open in Maps</a> | <a href="#" onclick="requestGPS();return false" style="font-weight:700;color:#14532d">Update</a> ✅</div>`; }
  el.innerHTML=html;
  document.getElementById('upliftLoc').innerHTML=globalLocation?`${globalLocation.lat.toFixed(6)}, ${globalLocation.lng.toFixed(6)} ±${globalLocation.accuracy}m<br>${globalLocation.timestamp}<br><a href="https://maps.google.com?q=${globalLocation.lat},${globalLocation.lng}" target="_blank">Open in Maps</a>`:'No GPS yet - tap ENABLE GPS at top';
  document.getElementById('tipLoc').innerHTML=globalLocation?`${globalLocation.lat.toFixed(6)}, ${globalLocation.lng.toFixed(6)} ±${globalLocation.accuracy}m`:'No GPS yet';
}

function requestGPS(){
  if(!window.isSecureContext){ toast('❌ Must be HTTPS for GPS'); checkHTTPS(); return; }
  if(!navigator.geolocation){ locStatus='denied'; locError='Geolocation not supported'; updateGPSBanner(); return; }
  locStatus='locating'; updateGPSBanner(); toast('📍 Requesting GPS - tap Allow when asked');
  navigator.geolocation.getCurrentPosition(
    pos=>{
      globalLocation={lat:pos.coords.latitude,lng:pos.coords.longitude,accuracy:Math.round(pos.coords.accuracy),timestamp:new Date().toLocaleString('en-GB'),iso:new Date().toISOString()};
      locStatus='granted'; toast(`✅ GPS: ${globalLocation.lat.toFixed(5)}, ${globalLocation.lng.toFixed(5)} ±${globalLocation.accuracy}m`);
      if(watchId!==null) navigator.geolocation.clearWatch(watchId);
      watchId=navigator.geolocation.watchPosition(p=>{globalLocation={lat:p.coords.latitude,lng:p.coords.longitude,accuracy:Math.round(p.coords.accuracy),timestamp:new Date().toLocaleString('en-GB'),iso:new Date().toISOString()};updateGPSBanner();updatePreviews();},null,{enableHighAccuracy:true,maximumAge:10000});
      updateGPSBanner(); updatePreviews(); localStorage.setItem('pcf_gps',JSON.stringify(globalLocation));
      if(window.shiftJobs&&shiftJobs.length>0&&!shiftJobs[0].location){shiftJobs[0].location={...globalLocation}; renderJobs();}
    },
    err=>{
      if(err.code===1){locStatus='blocked';locError='Permission denied - you tapped Block';}
      else if(err.code===2){locStatus='denied';locError='Position unavailable - no signal, try outside';}
      else{locStatus='denied';locError='Timeout - poor signal, try again outside';}
      toast('❌ GPS: '+locError); updateGPSBanner();
    },
    {enableHighAccuracy:true,timeout:15000,maximumAge:0}
  );
}

// --- rest of app logic ---
let shiftJobs=[{id:Date.now(),address:'',arrived:'',started:'',finished:'',status:'',location:null}];
let selectedTeam=new Set(), selectedReason=new Set();

function compress(file){return new Promise(res=>{const r=new FileReader();r.onload=()=>{const img=new Image();img.onload=()=>{const s=Math.min(1,1024/img.width);const c=document.createElement('canvas');c.width=img.width*s;c.height=img.height*s;c.getContext('2d').drawImage(img,0,0,c.width,c.height);res(c.toDataURL('image/jpeg',0.72));};img.onerror=()=>res(r.result);img.src=r.result;};r.readAsDataURL(file);});}

function init(){
  checkHTTPS();
  const savedGps=localStorage.getItem('pcf_gps'); if(savedGps){globalLocation=JSON.parse(savedGps); locStatus='granted';}
  updateGPSBanner();
  // chips
  const teamDiv=document.getElementById('teamChips'); TEAM.forEach(t=>{const s=document.createElement('span');s.className='chip';s.textContent=t;s.onclick=()=>{if(selectedTeam.has(t))selectedTeam.delete(t);else selectedTeam.add(t);s.classList.toggle('active');updatePreviews();};teamDiv.appendChild(s);});
  const reasonDiv=document.getElementById('reasonChips'); REASONS.forEach(r=>{const s=document.createElement('span');s.className='chip';s.textContent=r;s.onclick=()=>{if(selectedReason.has(r))selectedReason.delete(r);else selectedReason.add(r);s.classList.toggle('active');updatePreviews();};reasonDiv.appendChild(s);});
  const veh=document.getElementById('tVeh'); VEHICLES.forEach(v=>{const o=document.createElement('option');o.textContent=v;veh.appendChild(o);});
  const sites=document.getElementById('tSites'); SITES.forEach(s=>{const c=document.createElement('span');c.className='chip';c.textContent=s;c.onclick=()=>{sites.querySelectorAll('.chip').forEach(x=>x.classList.remove('active'));c.classList.add('active');updatePreviews();};sites.appendChild(c);});
  document.getElementById('tDate').value=todayISO(); document.getElementById('tTime').value=nowHM();
  document.querySelectorAll('.tab').forEach(tab=>tab.addEventListener('click',()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));tab.classList.add('active');const t=tab.dataset.tab;document.querySelectorAll('[id^="view-"]').forEach(v=>v.classList.add('hidden'));document.getElementById('view-'+t).classList.remove('hidden');}));
  document.getElementById('uPhotos').addEventListener('change',async e=>{for(const f of e.target.files){uPhotos.push(await compress(f));} renderU(); updatePreviews();});
  document.getElementById('tLeft').addEventListener('change',async e=>{tPhotos.left=await compress(e.target.files[0]); renderT();});
  document.getElementById('tRight').addEventListener('change',async e=>{tPhotos.right=await compress(e.target.files[0]); renderT();});
  document.getElementById('tBack').addEventListener('change',async e=>{tPhotos.back=await compress(e.target.files[0]); renderT();});
  renderJobs();
  updatePreviews();
  // block pull to refresh
  let sy=0; window.addEventListener('touchstart',e=>sy=e.touches[0].clientY,{passive:true});
  window.addEventListener('touchmove',e=>{if(window.scrollY===0&&e.touches[0].clientY>sy+10)e.preventDefault();},{passive:false});
  window.addEventListener('beforeunload',e=>{if(document.getElementById('addr').value||uPhotos.length>0){e.preventDefault();e.returnValue='Unsaved data';return e.returnValue;}});
}
function renderU(){const g=document.getElementById('uGrid');g.innerHTML='';uPhotos.forEach((s,i)=>{const img=document.createElement('img');img.src=s;img.style.width='100%';img.style.height='80px';img.style.objectFit='cover';img.style.borderRadius='8px';img.onclick=()=>{uPhotos.splice(i,1);renderU();updatePreviews();};g.appendChild(img);});}
function renderT(){const g=document.getElementById('tGrid');g.innerHTML='';Object.entries(tPhotos).forEach(([k,s])=>{const d=document.createElement('div');d.innerHTML=`<small>${k}</small><br><img src="${s}" style="width:100%;height:60px;object-fit:cover;border-radius:6px">`;g.appendChild(d);});}
function renderJobs(){const l=document.getElementById('jobsList');l.innerHTML='';shiftJobs.forEach((j,i)=>{const d=document.createElement('div');d.className='card';d.innerHTML=`<input value="${j.address}" placeholder="Job Address" oninput="shiftJobs[${i}].address=this.value;updatePreviews()" style="margin-bottom:6px"><div style="display:grid;grid-template-columns:1fr 1fr;gap:6px"><div><div class="time-grid"><input type="time" value="${j.arrived}" oninput="shiftJobs[${i}].arrived=this.value"><button onclick="shiftJobs[${i}].arrived=nowHM();this.previousElementSibling.value=shiftJobs[${i}].arrived">NOW</button></div></div><div><div class="time-grid"><input type="time" value="${j.finished}" oninput="shiftJobs[${i}].finished=this.value"><button onclick="shiftJobs[${i}].finished=nowHM();this.previousElementSibling.value=shiftJobs[${i}].finished">NOW</button></div></div></div><div style="font-size:11px;margin-top:6px">${j.location?`📍 ${j.location.lat.toFixed(5)},${j.location.lng.toFixed(5)} <a href="https://maps.google.com?q=${j.location.lat},${j.location.lng}" target="_blank">Map</a>`:'No location'} <button onclick="if(globalLocation){shiftJobs[${i}].location={...globalLocation};renderJobs();}else requestGPS()" style="margin-left:6px;padding:3px 8px;border-radius:6px;border:1px solid #6b7280;background:#fff;font-size:11px">LOG LOCATION</button></div>`;l.appendChild(d);});}
function addJob(){shiftJobs.push({id:Date.now(),address:'',arrived:'',started:'',finished:'',status:'',location:globalLocation?{...globalLocation}:null});renderJobs();}
function buildTextU(){const gps=globalLocation?`📍 GPS: https://maps.google.com?q=${globalLocation.lat},${globalLocation.lng} ±${globalLocation.accuracy}m ${globalLocation.timestamp}`:'📍 GPS: Not logged - needs HTTPS + tap ENABLE GPS';return `PERFECT CLEAN FIFE - UPLIFT\nTeam: ${Array.from(selectedTeam).join(', ')}\nReason: ${Array.from(selectedReason).join(', ')}\nAddress: ${document.getElementById('addr').value}\nJob Type: ${document.getElementById('jtype').value}\nJob No: ${document.getElementById('jnum').value}\nNotes: ${document.getElementById('jnotes').value}\nGas: ${document.getElementById('gas').value} Tyre: ${document.getElementById('tyre').value}\n\n${gps}\nPhotos: ${uPhotos.length}`;}
function buildTextT(){const gps=globalLocation?`📍 GPS: https://maps.google.com?q=${globalLocation.lat},${globalLocation.lng}`:'No GPS';return `PERFECT CLEAN FIFE - TIPPING\nVehicle: ${document.getElementById('tVeh').value}\nDate: ${document.getElementById('tDate').value} ${document.getElementById('tTime').value}\nNotes: ${document.getElementById('tNotes')?.value||''}\n${gps}`;}
function buildTextS(){let t=`PERFECT CLEAN FIFE - SHIFT\n`;shiftJobs.forEach((j,i)=>{t+=`${i+1}. ${j.address} Arr:${j.arrived} Fin:${j.finished} ${j.location?`GPS:https://maps.google.com?q=${j.location.lat},${j.location.lng}`:''}\n`;});if(globalLocation)t+=`\n📍 Current GPS: https://maps.google.com?q=${globalLocation.lat},${globalLocation.lng}`;return t;}
function updatePreviews(){document.getElementById('uPrev').value=buildTextU();document.getElementById('tPrev').value=buildTextT();document.getElementById('sPrev').value=buildTextS();}
async function share(text,file){try{if(file&&navigator.canShare&&navigator.canShare({files:[file]})){await navigator.share({text,files:[file]});toast('✅ Shared');return;}if(navigator.share){await navigator.share({text});if(file){const a=document.createElement('a');a.href=URL.createObjectURL(file);a.download=file.name;a.click();}return;}}catch(e){}await navigator.clipboard.writeText(text).catch(()=>{});if(file){const a=document.createElement('a');a.href=URL.createObjectURL(file);a.download=file.name;a.click();}window.open('https://wa.me/?text='+encodeURIComponent(text),'_blank');}
async function sendUplift(){const text=buildTextU();let file=null;if(uPhotos.length>0){const c=document.getElementById('uCanvas');const ctx=c.getContext('2d');const size=540;const cols=2;const rows=Math.ceil(uPhotos.length/cols);c.width=cols*size;c.height=rows*size;ctx.fillStyle='#fff';ctx.fillRect(0,0,c.width,c.height);await Promise.all(uPhotos.map((src,i)=>new Promise(r=>{const img=new Image();img.onload=()=>{const col=i%cols,row=Math.floor(i/cols);const scale=Math.min(size/img.width,size/img.height);ctx.drawImage(img,col*size+(size-img.width*scale)/2,row*size+(size-img.height*scale)/2,img.width*scale,img.height*scale);r();};img.src=src;})));const blob=await new Promise(r=>c.toBlob(r,'image/jpeg',0.85));file=new File([blob],'uplift.jpg',{type:'image/jpeg'});}share(text,file);}
async function sendTipping(){const all=Object.values(tPhotos);const text=buildTextT();let file=null;if(all.length>0){const c=document.createElement('canvas');const ctx=c.getContext('2d');c.width=1080;c.height=540;ctx.fillStyle='#fff';ctx.fillRect(0,0,c.width,c.height);await Promise.all(all.map((src,i)=>new Promise(r=>{const img=new Image();img.onload=()=>{ctx.drawImage(img,i*360,0,360,360);r();};img.src=src;})));const blob=await new Promise(r=>c.toBlob(r,'image/jpeg',0.85));file=new File([blob],'tipping.jpg',{type:'image/jpeg'});}share(text,file);}
function sendShift(){share(buildTextS(),null);}
window.addEventListener('DOMContentLoaded',init);
</script>
